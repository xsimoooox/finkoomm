{
  "expo": {
    "name": "VOXMANUS",
    "slug": "voxmanus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxmanus.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VOXMANUS utilise la caméra pour votre photo de profil.",
        "NSPhotoLibraryUsageDescription": "VOXMANUS accède à votre galerie pour votre photo de profil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D14"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.voxmanus.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
